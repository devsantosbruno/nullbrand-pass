{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo/node.tsbuildinfo"
  },
  "include": ["bin/**/*.ts", "src/**/*.ts", "src/types/node/**/*.d.ts"],
  "exclude": ["src/web/**", "src/shared/**"],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
