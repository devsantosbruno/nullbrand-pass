{
  "name": "nullbrand",
  "version": "0.1.0",
  "description": "100% local, offline password manager with an encrypted vault file (early release, not independently audited).",
  "type": "module",
  "bin": {
    "nullbrand": "dist/bin/nullbrand.js"
  },
  "exports": {
    ".": "./dist/src/vault.js",
    "./generator": "./dist/src/generator.js",
    "./formats": "./dist/src/formats/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/src/web",
    "!dist/**/*.d.ts",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE",
    "TRADEMARKS.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/copy-assets.mjs clean && tsc -b && node scripts/copy-assets.mjs copy",
    "typecheck": "tsc -b",
    "check": "node scripts/check-no-escape.mjs",
    "dev": "npm run build && node dist/bin/nullbrand.js ui --vault ./dev-vault.json --idle 0",
    "app:start": "npm --prefix desktop start",
    "test": "node --test dist/test/*.test.js scripts/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=dist/src/crypto.js --test-coverage-include=dist/src/vault.js --test-coverage-lines=90 --test-coverage-branches=80 dist/test/*.test.js scripts/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "keywords": [
    "password-manager",
    "vault",
    "offline",
    "local-first",
    "cli"
  ],
  "author": "Bruno Santos (https://github.com/devsantosbruno)",
  "license": "MIT",
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantosbruno/nullbrand-pass.git"
  },
  "homepage": "https://github.com/devsantosbruno/nullbrand-pass#readme",
  "bugs": {
    "url": "https://github.com/devsantosbruno/nullbrand-pass/issues"
  }
}
