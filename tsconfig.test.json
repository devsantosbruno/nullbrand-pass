{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo/test.tsbuildinfo"
  },
  "include": ["test/**/*.ts", "test/types/**/*.d.ts", "src/types/node/**/*.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
